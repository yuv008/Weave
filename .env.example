FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=weave

# Slack Events request URL: https://<host>/slack/events
# Bot scopes: channels:history, channels:read, channels:join.
# Do not add private-channel, group DM, or DM scopes.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WORKSPACE_DOMAIN=

# Single-tenant demo identity. This is not a per-user ACL.
WEAVE_TENANT_ID=
WEAVE_CONNECTION_ID=
WEAVE_WORKSPACE_ID=

# Notion. Pin NOTION_VERSION to the current REST version before use.
NOTION_TOKEN=
NOTION_VERSION=
NOTION_WORKSPACE_ID=
NOTION_CONNECTION_ID=

# Google Drive. The service-account JSON stays outside git.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CONNECTION_ID=
