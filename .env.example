FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=weave

# Shared contract. The company graph is co:{WEAVE_TENANT}.
WEAVE_TENANT=acme
WEAVE_CONFIG=config/weave.yaml
# Only this address receives level and department from a Slack profile merge.
WEAVE_VIEWER_EMAIL=
WEAVE_VIEWER_LEVEL=
WEAVE_VIEWER_DEPT=
# Hosted FalkorDB (overrides FALKORDB_HOST/PORT for shared/ code):
# FALKORDB_URL=falkors://<user>:<password>@<host>:<port>
FALKORDB_URL=
# Neon: `neon deploy` / `neon env pull` writes these to .env.local (gitignored).
# DATABASE_URL is the pooled endpoint for queries; DATABASE_URL_UNPOOLED is direct, for migrations.
# Local docker-compose default:
DATABASE_URL=postgresql://weave:weave@localhost:5432/weave
DATABASE_URL_UNPOOLED=

# Slack Events request URL: https://<host>/slack/events
# Ingest scopes: channels:history, channels:read, channels:join, users:read, users:read.email.
# Answer scopes: app_mentions:read, chat:write, im:history, im:read, im:write,
# mpim:history, mpim:read, users:read.
# Events: app_mention, message.im, message.mpim, message.channels.
# SLACK_USER_MAP maps a real Slack user id to a person when Person.slack_id does not:
# U012REAL=sam,U045REAL=priya
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_WORKSPACE_DOMAIN=
SLACK_USER_MAP=

# Single-tenant demo identity. This is not a per-user ACL.
WEAVE_TENANT_ID=
WEAVE_CONNECTION_ID=
WEAVE_WORKSPACE_ID=

# Notion. Pin NOTION_VERSION to the current REST version before use.
NOTION_TOKEN=
NOTION_VERSION=
NOTION_WORKSPACE_ID=
NOTION_CONNECTION_ID=

# Google Drive. The service-account JSON stays outside git.
GOOGLE_SERVICE_ACCOUNT_FILE=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_CONNECTION_ID=

# GitHub. One repository. Fine-grained token: Metadata, Issues, and Pull requests read.
# Do not grant Contents. Webhook: POST /github/webhook. Subscribe to Issues and Pull requests, not Pushes.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_CONNECTION_ID=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_VERSION=

# Groq. The answer agent, Slack replies, and the watcher handoff all use this.
# Paste the key here. It is not written into the repo.
GROQ_API_KEY=
